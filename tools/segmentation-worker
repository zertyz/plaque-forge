#!/usr/bin/env bash
set -euo pipefail

root="/tmp/plaque-forge-python"
repo="$(cd "$(dirname "$0")/.." && pwd)"
export XDG_CACHE_HOME="$root/cache/xdg"
export XDG_CONFIG_HOME="$root/config"
export XDG_DATA_HOME="$root/data"
export HF_HOME="$root/cache/huggingface"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TORCH_HOME="$root/cache/torch"
export MPLCONFIGDIR="$root/cache/matplotlib"
export TRITON_CACHE_DIR="$root/cache/triton"
export TORCHINDUCTOR_CACHE_DIR="$root/cache/torchinductor"
export TORCH_EXTENSIONS_DIR="$root/cache/torch-extensions"
export PYTHONPYCACHEPREFIX="$root/cache/pycache"
export TMPDIR="$root/tmp"
export PYTHONUNBUFFERED=1
export PLAQUE_FORGE_PYTHON_ROOT="$root"
export PLAQUE_FORGE_RUNTIME_MANIFEST="$root/runtime-manifest.json"

printf '[ml] Python exec: pid=%d, python=%s, runtime=%s\n' "$$" "$root/venv/bin/python" "$root" >&2
exec "$root/venv/bin/python" "$repo/tools/segmentation_worker.py" "$@"
